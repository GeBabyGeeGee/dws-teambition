{
  "name": "teambition",
  "version": "0.2.0",
  "description": "Teambition project management via DingTalk OpenAPI. Supports Excel-to-Teambition reproducible sync workflow with auto task classification.",
  "type": "user",
  "minCLIVersion": "v1.0.18",
  "mcpServers": {
    "teambition": {
      "type": "stdio",
      "command": "${DWS_PLUGIN_ROOT}/bin/server.exe",
      "args": [],
      "env": {
        "DWS_CLIENT_ID": "${DWS_CLIENT_ID}",
        "DWS_CLIENT_SECRET": "${DWS_CLIENT_SECRET}"
      }
    }
  },
  "build": {
    "command": "bun build --compile src/server.ts --outfile bin/server",
    "output": "bin/server"
  },
  "skills": "./skills/",
  "hooks": "./hooks/hooks.json"
}
